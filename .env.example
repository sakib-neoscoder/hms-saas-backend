# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_db

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets & Expirations
JWT_ACCESS_SECRET=bd_clinic_super_secret_jwt_access_token_key_32chars_min
JWT_REFRESH_SECRET=bd_clinic_super_secret_jwt_refresh_token_key_32chars_min
JWT_ACCESS_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=clinic-management-storage
R2_PUBLIC_URL=https://pub-your_cloudflare_id.r2.dev
